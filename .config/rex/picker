#!/bin/zsh
# Usage: picker jump [CLIENT]
# Reads one key press for the tab jump. rex.ui.pick cannot read one key, so this stays a script.
# With CLIENT, show this picker's tab in that Rex app first.
mode=$1 client=$2
if [[ -n "$client" ]]; then
  window=$(rex block inspect "$REX_BLOCK" --json | jq -r .block.window_id)
  rex -C "$client" do session.select session_id="$REX_SESSION" window_id="$window" >/dev/null
fi

case $mode in
  jump)
    print -n 'Press the letter of a tab. Any other key cancels. '
    read -k 1 key
    rex ${client:+-C "$client"} do jump_to hint="$key" >/dev/null
    ;;
esac
