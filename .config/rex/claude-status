#!/bin/sh
# Report Claude Code state to Rex (OSC 7501) from a Claude Code hook.
# Usage: claude-status <working|done|clear|notify>
[ -n "$REX_BLOCK" ] || exit 0

input=$(cat)
state=$1
kind=""
msg=""

case "$state" in
  notify)
    case "$(printf '%s' "$input" | jq -r '.notification_type // empty')" in
      permission_prompt) state=blocked kind=permission ;;
      elicitation_dialog) state=blocked kind=question ;;
      *) exit 0 ;;
    esac
    msg=$(printf '%s' "$input" | jq -r '.message // empty')
    ;;
  done) msg="Finished" ;;
esac

pid=$PPID
while [ "${pid:-1}" -gt 1 ]; do
  tty=$(ps -o tty= -p "$pid" | tr -d ' ')
  [ -n "$tty" ] && [ "$tty" != "??" ] && break
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done
[ -w "/dev/$tty" ] || exit 0

report="state=$state:app=claude"
[ -n "$kind" ] && report="$report:kind=$kind"
[ -n "$msg" ] && report="$report:msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
printf '\033]7501;%s\033\\' "$report" > "/dev/$tty"
